ket, t: Throwable, response: Response?) {\n53\t                isConnected = false\n54\t                Log.e(TAG, \"WebSocket ошибка: ${t.message}\")\n55\t            }\n56\t\n57\t            override fun onClosed(webSocket: WebSocket, code: Int, reason: String) {\n58\t                isConnected = false\n59\t                Log.d(TAG, \"WebSocket закрыт: $reason\")\n60\t            }\n61\t        })\n62\t    }\n63\t\n64\t    fun disconnect() {\n65\t        webSocket?.close(1000, \"Activity destroyed\")\n66\t        webSocket = null\n67\t        isConnected = false\n68\t    }\n69\t}"
